[sub_resource type="Resource" id="Resource_ntbfp"]
script = ExtResource("1_ntbfp")
text = "[right]Garlic Farmer: [color=forestgreen]‘We have so much left over that we would like to donate the garlic and hang it around the village. That should keep the vampires at a safe distance.’[/color][/right] [p][/p] [p][right]Regis: [color=orangered]'How would you care to help our friend?'[/color][/right][/p] [p][/p] [p]Option 1: [color=orangered]'Would you politely send him away?'[/color][/p] [p]Result: +20 suspicion[/p] [p]Public opinion: [color=dodgerblue]Why does he hate garlic so much?[/color][/p] [p][/p] [p]Option 2: [color=orangered]'Or would you follow through on his offer?'[/color][/p] [p][/p] [p]Result: +7 villagers & [color=forestgreen]Garlic[/color] is hung throughout the village.[/p] [p]Public opinion: [color=dodgerblue]The town is a little safer and attracts new residents.[/color][/p]"
responses = Array[ExtResource("2_jrqby")]([SubResource("Resource_7lx1f"), SubResource("Resource_hpiya")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

