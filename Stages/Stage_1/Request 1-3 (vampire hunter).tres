metadata/_custom_type_script = "uid://bt7dbtglx23uf"

[sub_resource type="Resource" id="Resource_fbt2a"]
script = ExtResource("1_51kc8")
text = "Count Downey: [color=crimson]‘How many village lunatics are wandering around here?!’[/color] [p][/p] [p]Vampire Hunter: [color=gold]‘Vampires are not to be taken lightly.’[/color][/p] [p][/p] [p]Count Downey: [color=crimson]‘Nonsense! Vampires do not exist. It is ridiculous!’[/color][/p] [p][/p] [p]Vampire Hunter: [color=gold]‘I believe you are the village lunatic here.’[/color][/p] [p][/p] [p]Results:[/p] [p]+20 suspicion[/p] [p]Public opinion: [color=dodgerblue]The villagers do not quite understand why you are having him hanged. Could it be that you have something to hide, or is he really just another village lunatic?[/color][/p] [p]3 guards busy — Three guards will be occupied for a while, as they have to hang the rather strong man.[/p] [p]-30 min.[/p]"
responses = Array[ExtResource("2_akh58")]([SubResource("Resource_68lk4")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

[sub_resource type="Resource" id="Resource_i6023"]
script = ExtResource("2_akh58")
label = "'Maybe I shouldn't have...'"
action = 1
color = Color(0.8627451, 0.078431375, 0.23529412, 1)
metadata/_custom_type_script = "uid://bt7dbtglx23uf"

[sub_resource type="Resource" id="Resource_gbxo2"]
script = ExtResource("1_51kc8")
text = "Count Downey: [color=crimson]‘Not that I expect any vampires to be wandering around here, but the people in the village think otherwise.’[/color] [p][/p] [p]Vampire Hunter: [color=gold]‘The people in your village are wise. You can never know for certain who is a vampire. From vagrants to regents, I have encountered all kinds.’[/color][/p] [p][/p] [p]Count Downey: [color=crimson]‘Yes, yes, yes. As I already said, I am not going to send you away. I simply do not believe you will find anything in my village.’[/color] [/p] [p][/p] [p]Vampire Hunter: [color=gold]‘Should I unexpectedly encounter such a monstrosity, you will be the first to hear about it.’[/color] [/p] [p][/p] [p]Results:[/p] [p]+40 suspicion[/p] [p][color=gold]The vampire hunter teaches the villagers to remain vigilant. He also points out that you or your adviser could very well be a vampire.[/color][/p] [p]+10 villagers[/p] [p][color=dodgerblue]The news that a vampire hunter is patrolling the area gives people throughout the region confidence that your village is free of vampires.[/color]"
responses = Array[ExtResource("2_akh58")]([SubResource("Resource_i6023")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

