metadata/_custom_type_script = "uid://bt7dbtglx23uf"

[sub_resource type="Resource" id="Resource_ykw1g"]
script = ExtResource("2_24uhq")
label = "Deep sigh. He opens the coffin."
values = Dictionary[int, int]({
7: 2
})
metadata/_custom_type_script = "uid://bt7dbtglx23uf"

[sub_resource type="Resource" id="Resource_un1s2"]
script = ExtResource("1_k2goq")
text = "[color=orangered]‘Sir, it really is time to get up now.’[/color] [p]...[/p] [p]Regis knocks even harder on the coffin.[/p] [p][/p] [p][color=orangered]‘Time is running out, sir! The people in the village need your help.’[/color][/p]"
responses = Array[ExtResource("2_24uhq")]([SubResource("Resource_o3bkd"), SubResource("Resource_ykw1g")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

[sub_resource type="Resource" id="Resource_71qao"]
script = ExtResource("2_24uhq")
label = "'Sigh...'"
action = 2
color = Color(0.8627451, 0.078431375, 0.23529412, 1)
metadata/_custom_type_script = "uid://bt7dbtglx23uf"

[sub_resource type="Resource" id="Resource_qhx4y"]
script = ExtResource("1_k2goq")
text = "After snoozing a little while longer, you finally wake up and open the coffin. [p][/p] [p][color=orangered]‘About time, for God's sake. Hopefully, you can still make it in time.’[/color][/p] "
responses = Array[ExtResource("2_24uhq")]([SubResource("Resource_71qao")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

[sub_resource type="Resource" id="Resource_51gxk"]
script = ExtResource("2_24uhq")
label = "‘Goddammit, I have a headache.’"
action = 2
color = Color(0.8627451, 0.078431375, 0.23529412, 1)
metadata/_custom_type_script = "uid://bt7dbtglx23uf"

[sub_resource type="Resource" id="Resource_lfvaf"]
script = ExtResource("1_k2goq")
text = "[color=orangered]‘Mr Downey, it’s good that you’re finally awake. I hope you showed at least some restraint last night.’[/color]"
responses = Array[ExtResource("2_24uhq")]([SubResource("Resource_51gxk")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

[sub_resource type="Resource" id="Resource_tfx1c"]
script = ExtResource("2_24uhq")
label = "Count Downey rubs his head and his eyes. "
action = 2
metadata/_custom_type_script = "uid://bt7dbtglx23uf"

[sub_resource type="Resource" id="Resource_7r7mw"]
script = ExtResource("1_k2goq")
text = "[color=crimson]‘Oof. I had one hell of a trip. I was a detective in a red iron suit and could talk to animals.’[/color]"
responses = Array[ExtResource("2_24uhq")]([SubResource("Resource_tfx1c")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

[sub_resource type="Resource" id="Resource_hqhtd"]
script = ExtResource("2_24uhq")
label = "He slowly gets to his feet."
action = 2
metadata/_custom_type_script = "uid://bt7dbtglx23uf"

[sub_resource type="Resource" id="Resource_m3k83"]
script = ExtResource("1_k2goq")
text = "[color=orangered]‘Just hurry up. People are waiting for you at the castle.’[/color]"
responses = Array[ExtResource("2_24uhq")]([SubResource("Resource_hqhtd")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

[sub_resource type="Resource" id="Resource_4m54n"]
script = ExtResource("2_24uhq")
label = "The Count gives a big Yawn."
action = 2
metadata/_custom_type_script = "uid://bt7dbtglx23uf"

[sub_resource type="Resource" id="Resource_sbo8a"]
script = ExtResource("1_k2goq")
text = "[color=orangered]‘You only have five days left until the feast.’[/color] [p][/p] [p][color=crimson]‘There are still nowhere near enough villagers to feed everyone.’[/color][/p]"
responses = Array[ExtResource("2_24uhq")]([SubResource("Resource_4m54n")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

[sub_resource type="Resource" id="Resource_3d4p0"]
script = ExtResource("2_24uhq")
label = "Count Downey stretches his back."
action = 2
metadata/_custom_type_script = "uid://bt7dbtglx23uf"

[sub_resource type="Resource" id="Resource_6eav1"]
script = ExtResource("1_k2goq")
text = "[color=orangered]‘Then perhaps sir should consider drinking less himself.’[/color] [p][/p] [p][color=crimson]‘Oh, come on, Regis, that abstinence of yours will be the death of you one day.’[/color][/p]"
responses = Array[ExtResource("2_24uhq")]([SubResource("Resource_3d4p0")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

[sub_resource type="Resource" id="Resource_fi5m4"]
script = ExtResource("2_24uhq")
label = "‘I’m going, I’m going.’"
action = 2
color = Color(0.8627451, 0.078431375, 0.23529412, 1)
metadata/_custom_type_script = "uid://bt7dbtglx23uf"

[sub_resource type="Resource" id="Resource_sr2lq"]
script = ExtResource("1_k2goq")
text = "[color=orangered]‘If you have no intention of stopping, then if I were you, I would make sure there are enough villagers. And not to many guards around.’[/color]"
responses = Array[ExtResource("2_24uhq")]([SubResource("Resource_fi5m4")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

[sub_resource type="Resource" id="Resource_fdr1h"]
script = ExtResource("2_24uhq")
label = "‘What?’"
action = 2
color = Color(0.8627451, 0.078431375, 0.23529412, 1)
metadata/_custom_type_script = "uid://bt7dbtglx23uf"

[sub_resource type="Resource" id="Resource_qoqkc"]
script = ExtResource("1_k2goq")
text = "[color=orangered]‘And Count…’[/color]"
responses = Array[ExtResource("2_24uhq")]([SubResource("Resource_fdr1h")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

[sub_resource type="Resource" id="Resource_w6nbp"]
script = ExtResource("2_24uhq")
label = "‘Yeah, yeah’"
action = 1
color = Color(0.8627451, 0.078431375, 0.23529412, 1)
metadata/_custom_type_script = "uid://bt7dbtglx23uf"

[sub_resource type="Resource" id="Resource_ygnyh"]
script = ExtResource("1_k2goq")
text = "[color=orangered]‘Stay out of the light and try not to draw attention to yourself.’[/color]"
responses = Array[ExtResource("2_24uhq")]([SubResource("Resource_w6nbp")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

