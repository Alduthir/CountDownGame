script = ExtResource("1_k2goq")
text = "[right]Regis: [color=orangered]‘Wake up!'[/color][p][right]…[/right][/p] [p][right]He knocks on the coffin. [color=orangered]‘Hello?!?’[/color][/right][/p] [p][right][color=orangered]‘Wake up, Mr Downey!’[/color][/right][/p]"
