[sub_resource type="Resource" id="Resource_un1s2"]
script = ExtResource("1_k2goq")
text = "[right][color=orangered]‘Sir, it really is time to get up now.’[/color][/right] [p][right]Regis knocks even harder on the coffin.[/right][/p] [p][right][color=orangered]‘Time is running out, sir! The people in the village need your help.’[/color][/right][/p]"
