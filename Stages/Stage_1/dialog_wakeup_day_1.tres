[sub_resource type="Resource" id="Resource_qhx4y"]
script = ExtResource("1_k2goq")
text = "[left]After snoozing a little while longer, you finally wake up and open the coffin.[/left] [p][/p] [p][right][color=orangered]‘About time, for God's sake. Hopefully, you can still make it in time.’[/color][/right][/p] "
