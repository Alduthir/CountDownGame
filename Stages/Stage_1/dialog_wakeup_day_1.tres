label = "‘I’m coming, I’m coming.’"
values = Dictionary[int, int]({
1: 3,
7: 3
})
color = Color(0.8627451, 0.078431375, 0.23529412, 1)
metadata/_custom_type_script = "uid://bt7dbtglx23uf"

[sub_resource type="Resource" id="Resource_wy6ru"]
script = ExtResource("1_k2goq")
text = "[b]Regis:[/b] [color=orangered]‘Wake up!'[/color] [p][/p] [p]He knocks on the coffin. [color=orangered]‘Hello?!?’[/color][/p] [p][/p] [p][color=orangered]‘Wake up, Mr Downey!’[/color][/p]"
responses = Array[ExtResource("2_24uhq")]([SubResource("Resource_pcam2"), SubResource("Resource_qtpgy")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

