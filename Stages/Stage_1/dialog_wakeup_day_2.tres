[sub_resource type="Resource" id="Resource_td61u"]
script = ExtResource("2_8b03m")
label = "“Go away!”"
action = 2
color = Color(0.8627451, 0.078431375, 0.23529412, 1)
metadata/_custom_type_script = "uid://bt7dbtglx23uf"

[sub_resource type="Resource" id="Resource_6qtk6"]
script = ExtResource("1_inp46")
text = "[p align=right][color=orangered]“It’s time, Mr. Downey! Wake up!”[/color][/p][p align=left]Regis knocks on the coffin.[/p][p align=left][color=crimson]“Are we going to do this every day?!” [/color][/p]"
responses = Array[ExtResource("2_8b03m")]([SubResource("Resource_td61u")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

[sub_resource type="Resource" id="Resource_pcam2"]
script = ExtResource("2_8b03m")
label = "'I'll wake up when I wake up!'"
action = 2
color = Color(0.8627451, 0.078431375, 0.23529412, 1)
metadata/_custom_type_script = "uid://bt7dbtglx23uf"

[sub_resource type="Resource" id="Resource_nbar7"]
script = ExtResource("1_inp46")
text = "[p align=right][color=orangered]“Today is the feast. Your family can be here any moment. So wake up!”[/color][/p]"
responses = Array[ExtResource("2_8b03m")]([SubResource("Resource_pcam2")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

[sub_resource type="Resource" id="Resource_lfvaf"]
script = ExtResource("2_8b03m")
label = "‘He’s rather persistent.’"
action = 2
color = Color(0.8627451, 0.078431375, 0.23529412, 1)
metadata/_custom_type_script = "uid://bt7dbtglx23uf"

[sub_resource type="Resource" id="Resource_36yly"]
script = ExtResource("1_inp46")
text = "[p align=right][color=orangered]“Mr. Downey, I’m afraid I can’t…”[/color][/p][p align=right][color=mediumvioletred]“Is he ever going to leave us alone?”[/color][/p][p align=right][color=orangered]“Is there someone in the coffin with you?”[/color][/p][p align=left][color=crimson]“I have no idea.”[/color][/p]"
responses = Array[ExtResource("2_8b03m")]([SubResource("Resource_lfvaf")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

[sub_resource type="Resource" id="Resource_inp46"]
script = ExtResource("2_8b03m")
label = "“I can think of something.”"
action = 2
color = Color(0.8627451, 0.078431375, 0.23529412, 1)
metadata/_custom_type_script = "uid://bt7dbtglx23uf"

[sub_resource type="Resource" id="Resource_myoev"]
script = ExtResource("1_inp46")
text = "[p align=right][color=mediumvioletred]“Why doesn’t he sleep in?”[/color][/p][p align=left][color=crimson]“He’s been sober for years.”[/color][/p][p align=right][color=mediumvioletred]“SOBER?! I can’t imagine anyone giving up drinking. There’s nothing better than a bite of blood in the morning… or afternoon… or evening…”[/color][/p]"
responses = Array[ExtResource("2_8b03m")]([SubResource("Resource_inp46")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

[sub_resource type="Resource" id="Resource_8b03m"]
script = ExtResource("2_8b03m")
label = "“Yes, yes, we’re coming.”"
action = 2
color = Color(0.8627451, 0.078431375, 0.23529412, 1)
metadata/_custom_type_script = "uid://bt7dbtglx23uf"

[sub_resource type="Resource" id="Resource_j6771"]
script = ExtResource("1_inp46")
text = "[p align=right][color=mediumvioletred]“Hee hee hee! Oh, Downey!”[/color][/p][p align=right][color=orangered]“Sir, please come out. There are people walking around the graveyard. If they hear you, then…”[/color][/p]"
responses = Array[ExtResource("2_8b03m")]([SubResource("Resource_8b03m")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

[sub_resource type="Resource" id="Resource_qhjp3"]
script = ExtResource("2_8b03m")
label = "“I love playing with my food!”"
action = 2
color = Color(0.8627451, 0.078431375, 0.23529412, 1)
metadata/_custom_type_script = "uid://bt7dbtglx23uf"

[sub_resource type="Resource" id="Resource_od3j0"]
script = ExtResource("1_inp46")
text = "[p align=right][color=mediumvioletred]“I don’t think so.”[/color][/p][p align=left][color=crimson]“Oh!”[/color][/p][p align=right][color=mediumvioletred]“If they bother us, we’ll have an appetizer ready.”[/color][/p]"
responses = Array[ExtResource("2_8b03m")]([SubResource("Resource_qhjp3")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

[sub_resource type="Resource" id="Resource_un1s2"]
