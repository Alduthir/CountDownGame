label = "“I, uhm…”"
action = 2
color = Color(1, 0.27058825, 0, 1)
metadata/_custom_type_script = "uid://bt7dbtglx23uf"

[sub_resource type="Resource" id="Resource_qey67"]
script = ExtResource("1_inp46")
text = "[p align=right]Gravedigger: [color=dimgray]“What do I hear in there?!”[/color][/p][p align=left]The gravedigger enters the tomb.[/p][p align=right]Gravedigger: [color=dimgray]“Regis! What are you doing here?! And why are you talking to that coffin?!”[/color][/p]"
responses = Array[ExtResource("2_8b03m")]([SubResource("Resource_un1s2")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

[sub_resource type="Resource" id="Resource_o3bkd"]
script = ExtResource("2_8b03m")
label = "“Oh, Downey!”"
action = 2
color = Color(0.78039217, 0.08235294, 0.52156866, 1)
metadata/_custom_type_script = "uid://bt7dbtglx23uf"

[sub_resource type="Resource" id="Resource_60wqk"]
script = ExtResource("1_inp46")
text = "[p align=right]Vampire Hunter: [color=gold]“I told you! HE is the vampire who has been killing all the villagers!”[/color][/p][p align=right]Guard: [color=dimgray]“Hang him!”[/color][/p][p align=right]Priest: [color=palegoldenrod]“Let him burn in the sun!”[/color][/p][p align=right]Peter: [color=indigo]“We’ll teach him a lesson!”[/color][/p][p align=right]Garlic Farmer: [color=forestgreen]“Force him to eat garlic!”[/color][/p]"
responses = Array[ExtResource("2_8b03m")]([SubResource("Resource_o3bkd")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

[sub_resource type="Resource" id="Resource_ykw1g"]
script = ExtResource("2_8b03m")
label = "“Oh, Serena!”"
action = 2
color = Color(0.8627451, 0.078431375, 0.23529412, 1)
metadata/_custom_type_script = "uid://bt7dbtglx23uf"

[sub_resource type="Resource" id="Resource_gm242"]
script = ExtResource("1_inp46")
text = "[p align=right]Butcher: [color=lightslategray]“Chop him into pieces!”[/color][/p][p align=right]Doctor: [color=salmon]“Drain his blood for medical experiments!”[/color][/p][p align=right]Village Elder: [color=dimgray]“YEAH!”[/color][/p][p align=right][color=orangered][shake rate=20.0 level=5 connected=1]“I told you to get out of that coffin!”[/shake][/color][/p]"
responses = Array[ExtResource("2_8b03m")]([SubResource("Resource_ykw1g")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

[sub_resource type="Resource" id="Resource_dhfvs"]
script = ExtResource("2_8b03m")
label = "“Oh, gravedigger!”"
action = 2
color = Color(1, 0.27058825, 0, 1)
metadata/_custom_type_script = "uid://bt7dbtglx23uf"

[sub_resource type="Resource" id="Resource_jx6mg"]
script = ExtResource("1_inp46")
text = "[p]Regis grabs the gravedigger and bites him in the neck. He drains him like an alcoholic emptying his first bottle of wine after two years of abstinence. His first sips are very cautious and filled with regret, but as soon as the guilt fades, he sucks the gravedigger dry.[/p][p][/p][p]The body collapses like a sack of garlic.[/p]"
responses = Array[ExtResource("2_8b03m")]([SubResource("Resource_dhfvs")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

