[sub_resource type="Resource" id="Resource_ogwty"]
script = ExtResource("1_inp46")
text = "[p]Regis transforms into a bloodthirsty monster. He sinks his claws into the vampire hunter first and tears him in two. He tears the garlic farmer into three pieces, the doctor into four, the priest into five… until everyone is dead.[/p][p][/p][p]When Downey and Serena step out of the coffin, they are met with a vast, bloody massacre. Regis is crouched in the corner of the tomb. He looks like a guilty dog that has just eaten food from the table.[/p]"
responses = Array[ExtResource("2_8b03m")]([SubResource("Resource_te00c"), SubResource("Resource_ritn3")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

