[sub_resource type="Resource" id="Resource_umpah"]
script = ExtResource("1_npjfi")
text = "[p align=left]You come across the towns doctor. She is concerned about the people who ate at the vegetable stall.[/p][p align=right]Doctor: [color=salmon]‘Something must be done. People are vomiting everything back up, and several people have already died.’[/color][/p] [p][/p][p]Option 1: [color=crimson]‘Have them clear out the stall.’[/color][/p][p]Result: -20 suspicion & -3 villagers[/p] [p][/p][p]Option 2: [color=crimson]‘It’s because of that garlic!’[/color][/p][p]Result: remove [color=forestgreen]garlic[/color] in the village & -6 villagers & +10 suspicion[/p] [p][/p][p]Option 3: [color=crimson]‘Leave it. It’s flu season. Do I really have to explain that to you?’[/color][/p][p]Result: -6 villagers[/p]"
responses = Array[ExtResource("2_di02v")]([SubResource("Resource_64bqk"), SubResource("Resource_hohwl"), SubResource("Resource_sp5d7")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

