[sub_resource type="Resource" id="Resource_ijhxo"]
script = ExtResource("1_sihnl")
text = "[p align=right][color=dimgray]‘With all the deaths lately, we will have to start clearing out graves. Unless sir makes the tomb available for us to use.’ [/color][/p] [p][/p][p align=left]Option 1: [color=crimson]‘Go ahead.’[/color][/p][p]Result: +20 suspicion[/p][p]It has proved unwise to have people wandering around the graveyard while you are sleeping there.[/p][p][/p][p]Option 2: [color=crimson]‘Get rid of him.’[/color][/p][p]Result: +30 suspicion[/p][p]The villagers wonder why the Count hates the gravedigger so much.[/p][p][/p][p]Option 3: [color=crimson]‘We will make sure fewer people die.’[/color][/p][p]Result: +3 guards[/p][p]As promised, more guards are now patrolling the streets.[/p]"
responses = Array[ExtResource("2_iim1n")]([SubResource("Resource_d2j8w"), SubResource("Resource_osxlw"), SubResource("Resource_te3wr")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

