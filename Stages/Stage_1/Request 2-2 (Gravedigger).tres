[sub_resource type="Resource" id="Resource_iim1n"]
script = ExtResource("1_sihnl")
text = "[p align=left]A sheperd walks by, but the gravedigger brutally shoves him aside.[/p][p align=right][color=dimgray]‘I have been waiting out here for two days because I want to speak to you!’[/color][/p]"
responses = Array[ExtResource("2_iim1n")]([SubResource("Resource_tqirw"), SubResource("Resource_787j1")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

