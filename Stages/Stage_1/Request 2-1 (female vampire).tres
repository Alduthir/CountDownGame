[sub_resource type="Resource" id="Resource_oticw"]
script = ExtResource("1_f8eo5")
text = "[p align=right]She blushes. [color=mediumvioletred]‘What do you say? Can I stay?’[/color][/p] [p][/p][p align=left]Option 1: [color=crimson]‘What an excellent idea!’[/color][/p] [p][/p][p]Result: -7 villagers[/p][p][color=mediumvioletred]A beautiful lady is staying in the village, with an appetite to rival your own.[/color][/p] [p][/p][p]Option 2: [color=crimson]‘Regis, could you leave us alone for a moment?’[/color][/p][p]Result: -7 villagers[/p][p][color=mediumvioletred]If you teach her how to hunt, she may teach you a thing or two.[/color][/p] [p][/p][p]Option 3: [color=crimson]‘Regis, what do you think?’[/color][/p][p][color=orangered]‘As if there is any point in saying it is a bad idea. You are going to let her stay anyway.’[/color][/p][p]Result: -7 villagers[/p][p][color=mediumvioletred]Let the Hunger Games begin![/color][/p]"
responses = Array[ExtResource("2_vq3qt")]([SubResource("Resource_w2smt")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

