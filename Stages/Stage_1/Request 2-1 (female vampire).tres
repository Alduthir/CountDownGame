[sub_resource type="Resource" id="Resource_7yahd"]
script = ExtResource("1_f8eo5")
text = "[p align=right][color=mediumvioletred]‘Good afternoon, Count Downey.’[/color][/p][p align=left][color=crimson]‘Good afternoon, young lady.’[/color][/p] [p align=left]Regis: [color=orangered]‘Welcome to the—’[/color][/p]"
responses = Array[ExtResource("2_vq3qt")]([SubResource("Resource_1fiol")])
