[sub_resource type="Resource" id="Resource_of357"]
script = ExtResource("2_vq3qt")
label = "'Are you sure you won't bother anyone?'"
color = Color(0.8627451, 0.078431375, 0.23529412, 1)
metadata/_custom_type_script = "uid://bt7dbtglx23uf"

[sub_resource type="Resource" id="Resource_v2lqg"]
script = ExtResource("1_f8eo5")
text = "[p align=left]Downey loses himself in the eyes of the beauty standing before him.[/p][p align=right][color=mediumvioletred]‘I am looking for a place to sleep. I promise I will not bother anyone.’[/color] She smiles mischievously.[/p] [p align=right]Regis: [color=orangered]‘I don’t think—’[/color][/p] "
responses = Array[ExtResource("2_vq3qt")]([SubResource("Resource_of357")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

