[sub_resource type="Resource" id="Resource_vq3qt"]
script = ExtResource("1_f8eo5")
text = "[p align=right]A young lady—a vampire not yet 200 years old—walks up to you.[/p][p align=left]Count Downey: [color=crimson]‘Time for a coffee break. This young lady will not cause anyone any trouble.’[/color][/p]"
responses = Array[ExtResource("2_vq3qt")]([SubResource("Resource_30bgd")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

