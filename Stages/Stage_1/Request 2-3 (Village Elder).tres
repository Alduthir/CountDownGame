[sub_resource type="Resource" id="Resource_64bqk"]
script = ExtResource("1_qvdbd")
text = "[p align=right]Village Elder: [color=darkkhaki]‘I no longer dare to go outside in the evening or at night. People are disappearing. They say vampires are roaming around.’[/color][/p][p align=left]Count Downey: [color=crimson]‘I prefer to stay indoors at night anyway.’[/color][/p]"
responses = Array[ExtResource("2_64bqk")]([SubResource("Resource_sp5d7")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

