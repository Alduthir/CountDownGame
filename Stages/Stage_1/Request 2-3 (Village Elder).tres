[sub_resource type="Resource" id="Resource_hohwl"]
script = ExtResource("1_qvdbd")
text = "[p align=right]Regis: [color=orangered]‘Those rumours have indeed been circulating more frequently, sir.’[/color][/p] [p][/p][p]Option 1: [color=crimson]‘Not every vampire drinks blood.’[/color][/p][p]Result: +20 suspicion[/p][p]How does he suddenly know so much about vampires?[/p] [p][/p][p]Option 2: [color=crimson]‘Who says it wasn’t a werewolf?’[/color][/p][p]Result: = -6 villagers & -20 suspicion[/p][p]The people are now convinced that not a vampire but a werewolf is roaming around. People flee your village.[/p] [p][/p][p]Option 3: [color=crimson]‘Have more guards patrol the streets!’[/color][/p][p]Result: + 3 guards & +2 villagers[/p][p]More guards are patrolling the streets, which is not the most convenient choice for tonight.[/p]"
responses = Array[ExtResource("2_64bqk")]([SubResource("Resource_4vgsm"), SubResource("Resource_hmxtj"), SubResource("Resource_bns57")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

