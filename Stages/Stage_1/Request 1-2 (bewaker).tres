[sub_resource type="Resource" id="Resource_s4d1k"]
script = ExtResource("2_c0hgo")
label = "The Count looks bored."
metadata/_custom_type_script = "uid://bt7dbtglx23uf"

[sub_resource type="Resource" id="Resource_c0hgo"]
script = ExtResource("1_xorxa")
text = "Guard: [color=dimgray]‘Mr. Downey, sir.’[/color] [p][/p] [p]Count Downey looks at the guard.[/p] [p][/p] [p]The guard keeps his eyes lowered and waits for the Count’s response.[/p]"
responses = Array[ExtResource("2_c0hgo")]([SubResource("Resource_s4d1k")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

[sub_resource type="Resource" id="Resource_vjnkr"]
script = ExtResource("2_c0hgo")
label = "'Congratulations.'"
color = Color(0.8627451, 0.078431375, 0.23529412, 1)
metadata/_custom_type_script = "uid://bt7dbtglx23uf"

[sub_resource type="Resource" id="Resource_kkik2"]
script = ExtResource("1_xorxa")
text = "Regis: [color=orangered]‘Go on.’[/color] [p][/p] [p]Guard: [color=dimgray]‘Thank you, sir. There is a group of refugees at the edge of the village, sir.’[/color][/p]"
responses = Array[ExtResource("2_c0hgo")]([SubResource("Resource_vjnkr")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

[sub_resource type="Resource" id="Resource_k80qm"]
script = ExtResource("2_c0hgo")
label = "'Fine.'"
color = Color(0.8627451, 0.078431375, 0.23529412, 1)
metadata/_custom_type_script = "uid://bt7dbtglx23uf"

[sub_resource type="Resource" id="Resource_fvj1w"]
script = ExtResource("1_xorxa")
text = "Regis: [color=orangered]‘What sir means to ask is what the refugees want.’[/color] [p][/p] [p]Guard: [color=dimgray]‘They were attacked by wolves in the forest. They are now weakened and injured, and they wish to stay here. At least until they have regained their strength.’[/color][/p] [p][/p] [p]Count Downey: [color=crimson]‘And why do I have to decide that?’[/color][/p] [p][/p] [p]Guard: [color=dimgray]‘To properly… help them, we need people to keep an eye on them.’[/color][/p]"
responses = Array[ExtResource("2_c0hgo")]([SubResource("Resource_k80qm")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

