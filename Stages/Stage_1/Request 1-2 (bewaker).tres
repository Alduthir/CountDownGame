[sub_resource type="Resource" id="Resource_xoxbe"]
script = ExtResource("1_xorxa")
text = "Option 1: [color=crimson]‘Keep them outside the village and assign a few guards to watch them.’[/color] [p][/p] [p]Result: 2 guards busy[/p] [p]The guard has sent two guards to the group of refugees to keep them away from the village. They may stay in the forest, but they are not allowed to set foot inside the village.[/p] [p][/p] [p]Option 2: [color=crimson]‘Take all your men and drive them away… or kill them. Before you know it, there will be a vampire among them.’[/color][/p] [p][/p] [p]Result: -20 suspicion[/p] [p]Public opinion: [color=dodgerblue]The villagers think it is very sensible of you to exterminate the refugees as a precaution. You can never be too careful: before you know it, someone gets hurt.[/color][/p] [p][/p] [p]Option 3: [color=crimson]‘Let them in. They are more than welcome.’[/color][/p] [p][/p] [p]Result: +7 villagers[/p] [p][color=dodgerblue]Such gastronomic hospitality![/color][/p]"
responses = Array[ExtResource("2_c0hgo")]([SubResource("Resource_vcupf"), SubResource("Resource_m6q1r"), SubResource("Resource_t2t3n")])
metadata/_custom_type_script = "uid://c2k7ystm53bkf"

